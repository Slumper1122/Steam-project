# Copy to .env and fill in. .env is gitignored and never copied into the image.

# Required — https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Optional — omit both to run fully offline (JSON + SQLite in the /data volume)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=

# Seconds between collection runs. 3600 = hourly.
COLLECT_INTERVAL_SECONDS=3600
